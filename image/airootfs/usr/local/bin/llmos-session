#!/bin/bash
# Start the compositor: Hyprland if it comes up, else cage (a single-window kiosk
# compositor that renders in software and works in any VM).
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=llmos
STATE="$HOME/.local/state/llmos"
mkdir -p "$STATE"
choice="${LLMOS_COMPOSITOR:-$(cat /etc/llmos/compositor 2>/dev/null || echo auto)}"

if [[ "$choice" != cage ]] && command -v Hyprland >/dev/null; then
  start=$(date +%s)
  Hyprland -c /etc/llmos/hyprland.conf > "$STATE/hyprland.log" 2>&1 &
  hypr=$!
  # Launch the shell ourselves once Hyprland's IPC socket exists, so we do not
  # depend on how a given Hyprland version reads exec-once from its config.
  for _ in $(seq 1 100); do
    sock=$(ls -t "$XDG_RUNTIME_DIR"/hypr/*/.socket.sock 2>/dev/null | head -1)
    [[ -n $sock ]] && break
    kill -0 $hypr 2>/dev/null || break
    sleep 0.2
  done
  if [[ -n ${sock:-} ]]; then
    export HYPRLAND_INSTANCE_SIGNATURE=$(basename "$(dirname "$sock")")
    for _ in $(seq 1 50); do
      WAYLAND_DISPLAY=$(cd "$XDG_RUNTIME_DIR" && ls -t wayland-* 2>/dev/null | grep -v '\.lock$' | head -1)
      [[ -n $WAYLAND_DISPLAY ]] && break
      sleep 0.2
    done
    export WAYLAND_DISPLAY
    echo "$(date -Is) Hyprland up ($HYPRLAND_INSTANCE_SIGNATURE, $WAYLAND_DISPLAY)" >> "$STATE/session.log"
    /usr/local/bin/llmos-launch &
  fi
  wait $hypr
  # a long-lived Hyprland that exits means the user quit; a quick exit means it could not start
  if (( $(date +%s) - start > 20 )); then exit 0; fi
  echo "$(date -Is) Hyprland exited after $(( $(date +%s) - start ))s, falling back to cage" >> "$STATE/session.log"
fi

export LLMOS_COMPOSITOR=cage WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1
export LLMOS_CHROMIUM_FLAGS="--disable-gpu ${LLMOS_CHROMIUM_FLAGS:-}"
exec cage -d -s -- /usr/local/bin/llmos-launch > "$STATE/cage.log" 2>&1
